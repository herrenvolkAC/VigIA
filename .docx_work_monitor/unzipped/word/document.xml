wingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId9"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="6217920" cy="2698750"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="167B9F3B" w14:textId="77777777" w:rsidR="008145ED" w:rsidRDefault="008145ED" w:rsidP="008145ED"><w:pPr><w:spacing w:before="60" w:after="200"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:i/><w:color w:val="5C6773"/><w:sz w:val="18"/></w:rPr><w:t>Figura 2. Pantalla actual de ingreso de una descarga.</w:t></w:r></w:p><w:p w14:paraId="10E103CD" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Ttulo2"/></w:pPr><w:r><w:t>2.1 Datos de la descarga</w:t></w:r></w:p><w:p w14:paraId="235B9CF3" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Listaconvietas"/><w:spacing w:after="80"/></w:pPr><w:r><w:t>Fecha y hora: confirmar el momento de la recepción.</w:t></w:r></w:p><w:p w14:paraId="0CA0E914" w14:textId="17BAFB72" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Listaconvietas"/><w:spacing w:after="80"/></w:pPr><w:r><w:t>Proveedor: escribir código o nombre y seleccionar una opción del listad</w:t></w:r><w:r w:rsidR="00D31A69"><w:t>o</w:t></w:r><w:r><w:t>.</w:t></w:r></w:p><w:p w14:paraId="141A4CBB" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Listaconvietas"/><w:spacing w:after="80"/></w:pPr><w:r><w:t>Recepcionista: buscar por legajo o nombre y seleccionar una opción del listado.</w:t></w:r></w:p><w:p w14:paraId="4FFE58B5" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Listaconvietas"/><w:spacing w:after="80"/></w:pPr><w:r><w:t>Pallets recibidos y pallets auditados: ingresar cantidades numéricas. Los auditados no pueden superar a los recibidos.</w:t></w:r></w:p><w:p w14:paraId="6B9DE920" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Listaconvietas"/><w:spacing w:after="80"/></w:pPr><w:r><w:t>Cuenta con novedad y Observación: completar cuando corresponda.</w:t></w:r></w:p><w:p w14:paraId="24055482" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Ttulo2"/></w:pPr><w:r><w:t>2.2 Selección de artículos / PLU</w:t></w:r></w:p><w:p w14:paraId="7B87B7A5" w14:textId="3EA43F33" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:r><w:t>En PLU asociados, comenzar a escribir el código o la descripción del artículo. El sistema muestra hasta 50 coincidencias de los sectores habilitados para refrigerados.</w:t></w:r></w:p><w:p w14:paraId="209D2C87" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Listaconvietas"/><w:spacing w:after="80"/></w:pPr><w:r><w:t>Seleccionar el artículo desde la lista sugerida; no escribir solamente un texto libre.</w:t></w:r></w:p><w:p w14:paraId="48C20CFC" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Listaconvietas"/><w:spacing w:after="80"/></w:pPr><w:r><w:t>Completar el porcentaje de afectación del PLU cuando corresponda.</w:t></w:r></w:p><w:p w14:paraId="5779067F" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Listaconvietas"/><w:spacing w:after="80"/></w:pPr><w:r><w:t>Agregar una observación específica del artículo si es necesario.</w:t></w:r></w:p><w:p w14:paraId="58FB2601" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Listaconvietas"/><w:spacing w:after="80"/></w:pPr><w:r><w:t>Usar + Agregar PLU para incorporar más artículos a la misma descarga.</w:t></w:r></w:p><w:p w14:paraId="35EDD579" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Ttulo2"/></w:pPr><w:r><w:t>2.3 Fotografías</w:t></w:r></w:p><w:p w14:paraId="00234606" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:r><w:t>El módulo admite fotografías generales de la descarga y fotografías específicas de cada PLU.</w:t></w:r></w:p><w:p w14:paraId="6441F718" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Listaconvietas"/><w:spacing w:after="80"/></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>Fotos de inspección: seleccionar imágenes generales del ingreso.</w:t></w:r></w:p><w:p w14:paraId="51B14649" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Listaconvietas"/><w:spacing w:after="80"/></w:pPr><w:r><w:t>Fotos de este PLU: utilizar el selector ubicado dentro de la fila del artículo para asociar imágenes a ese PLU.</w:t></w:r></w:p><w:p w14:paraId="18E23C55" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Listaconvietas"/><w:spacing w:after="80"/></w:pPr><w:r><w:t>Se pueden seleccionar múltiples archivos. Esperar a que finalice la carga antes de cerrar o cambiar de pantalla.</w:t></w:r></w:p><w:p w14:paraId="3A314C3D" w14:textId="6AD05AA9" w:rsidR="002832E3" w:rsidRDefault="002832E3"/><w:p w14:paraId="1046A551" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:spacing w:before="60" w:after="200"/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:i/><w:color w:val="5C6773"/><w:sz w:val="18"/></w:rPr><w:t>Figura 2. Pantalla actual de ingreso de una descarga.</w:t></w:r></w:p><w:p w14:paraId="0140D026" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Ttulo2"/></w:pPr><w:r><w:t>2.4 Guardar la descarga</w:t></w:r></w:p><w:p w14:paraId="2E7DEC5E" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Listaconnmeros"/><w:spacing w:after="100"/></w:pPr><w:r><w:t>Revisar proveedor, recepcionista, cantidades, PLU, porcentajes y fotografías.</w:t></w:r></w:p><w:p w14:paraId="2FE18C38" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Listaconnmeros"/><w:spacing w:after="100"/></w:pPr><w:r><w:t>Presionar Guardar descarga.</w:t></w:r></w:p><w:p w14:paraId="7ACD1CEA" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="Listaconnmeros"/><w:spacing w:after="100"/></w:pPr><w:r><w:t>Esperar el mensaje de confirmación con el ID asignado.</w:t></w:r></w:p><w:p w14:paraId="5A4DE7E6" w14:textId="2B0B3386" w:rsidR="002832E3" w:rsidRDefault="00000000" w:rsidP="00237E87"><w:r><w:br w:type="page"/></w:r><w:r w:rsidRPr="00237E87"><w:rPr><w:rFonts w:asciiTheme="majorHAnsi" w:eastAsiaTheme="majorEastAsia" w:hAnsiTheme="majorHAnsi" w:cstheme="majorBidi"/><w:b/><w:bCs/><w:color w:val="2E74B5"/><w:sz w:val="26"/><w:szCs w:val="26"/></w:rPr><w:lastRenderedPageBreak/><w:t>3. Consultar registros</w:t></w:r></w:p><w:p w14:paraId="79C635B9" w14:textId="77777777" w:rsidR="002832E3" w:rsidRDefault="00000000"><w:r><w:t>La solapa Registros permite buscar descargas ya guardadas. Se puede filtrar por proveedor o PLU y por rango de fechas.</w:t></w:r></w:p><w:p w14:paraId="4407EBE0" w14:textId="71243274" w:rsidR="002832E3" w:rsidRDefault="008145ED"><w:r w:rsidRPr="008145ED"><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="14B0817B" wp14:editId="496CEE71"><wp:extent cx="6217920" cy="1765300"/><wp:effectExtent l="0" t="0" r="0" b="6350"/><wp:docPr id="7" name="Imagen 7"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.or