# ──────────────────────────────────────────────────────────────────
# VigIA v2.0 · Configuración de proveedores IA
# Copiar este archivo como .env y completar los valores reales.
# NUNCA subir .env a un repositorio de código.
# ──────────────────────────────────────────────────────────────────

# Proveedor activo: "claude" | "azure" | "ollama"
AI_PROVIDER=claude
AI_TIMEOUT=300
# Mantener en 1. Si la red corporativa corta certificados, usar AI_CA_BUNDLE con el .pem de la CA interna.
AI_SSL_VERIFY=1
AI_CA_BUNDLE=

# ── Claude (Anthropic) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-REEMPLAZAR_CON_TU_CLAVE

# ── Azure OpenAI ───────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://mi-empresa.openai.azure.com/
AZURE_OPENAI_API_KEY=REEMPLAZAR_CON_TU_CLAVE_AZURE
AZURE_OPENAI_DEPLOYMENT=gpt-4o-coto
AZURE_OPENAI_API_VERSION=2024-02-01

# ── Ollama (Local / Self-hosted) ────────────────────────────────────
# URL del servidor Ollama (ej: http://localhost:11434)
OLLAMA_URL=http://localhost:11434
# Modelo disponible en Ollama (ej: mistral, llama2, neural-chat, etc)
OLLAMA_MODEL=mistral

# —— BD productiva Oracle (Analisis de productividad) ——
PRODUCTIVE_DB_USER=usuario_oracle
PRODUCTIVE_DB_PASSWORD=clave_oracle
PRODUCTIVE_DB_HOST=host_oracle
PRODUCTIVE_DB_PORT=1521
PRODUCTIVE_DB_SERVICE_NAME=service_name
# Opcional: si ya tenes un DSN armado, este valor pisa host/port/service_name
PRODUCTIVE_DB_DSN=
PRODUCTIVE_DB_CLIENT_LIB_DIR=
PRODUCTIVE_DB_USE_JDBC=1
PRODUCTIVE_DB_LOCAL_ONLY=0
PRODUCTIVE_DB_JDBC_TIMEOUT_SECONDS=300
PRODUCTIVE_DB_JAVA_BIN=
PRODUCTIVE_DB_JAVAC_BIN=
PRODUCTIVE_DB_OJDBC_JAR=

# Historia de Legajo - precarga controlada de actividad diaria WF
HISTORIA_ACTIVIDAD_SYNC_ENABLED=1
HISTORIA_ACTIVIDAD_SYNC_WINDOWS=21:00-22:00,05:00-06:00
HISTORIA_ACTIVIDAD_SYNC_START_DATE=2026-01-01
HISTORIA_ACTIVIDAD_SYNC_END_OFFSET_DAYS=1
HISTORIA_ACTIVIDAD_SYNC_DAYS_PER_RUN=1
HISTORIA_ACTIVIDAD_SYNC_POLL_SECONDS=300
HISTORIA_ACTIVIDAD_SYNC_MAX_SECONDS=240
HISTORIA_ACTIVIDAD_SYNC_STALE_MINUTES=15
# 0 = todos los legajos activos del ultimo legajero
HISTORIA_ACTIVIDAD_SYNC_MAX_LEGAJOS=0

# Novedades CD - monitoreo automatico de carpeta RRHH
# Usar rutas UNC para carpetas de red, no unidades mapeadas.
RRHH_WATCH_ENABLED=0
RRHH_WATCH_INBOX=\\xxxxxxx\xxxxx\KPI RRHH\BDs
RRHH_WATCH_IMPORTED=\\xxxxxxx\xxxxx\KPI RRHH\BDs\IMPORTADOS
RRHH_WATCH_ERROR=\\xxxxxxx\xxxxx\KPI RRHH\BDs\ERROR
RRHH_WATCH_POLL_SECONDS=60
RRHH_WATCH_STABILITY_SECONDS=30
RRHH_FRANCOS_FECHA_INICIAL=2026-05-26
